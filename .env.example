# Copy this file to ".env" and fill in your own values.
# The real .env file is listed in .gitignore, so it is never committed.

# --- Which model service to use -------------------------------------------
# "bedrock" (the default) or "anthropic".
SUPPORT_AGENT_PROVIDER=bedrock

# Leave empty to use the default model for the provider.
# Bedrock default: global.anthropic.claude-haiku-4-5-20251001-v1:0
# If your AWS account can use Claude 5 models: global.anthropic.claude-haiku-5-5
SUPPORT_AGENT_MODEL=

# --- Amazon Bedrock (needed when SUPPORT_AGENT_PROVIDER=bedrock) ------------
# The AWS region where you use Bedrock, for example us-east-1.
AWS_REGION=

# Sign-in, option A (simplest): a Bedrock API key.
# Create it in the AWS console under Amazon Bedrock > API keys.
AWS_BEARER_TOKEN_BEDROCK=

# Sign-in, option B: AWS access keys for an IAM user with Bedrock permission.
# Leave these empty if you use option A.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed if you use temporary AWS credentials.
AWS_SESSION_TOKEN=

# --- Anthropic API (needed only when SUPPORT_AGENT_PROVIDER=anthropic) ------
ANTHROPIC_API_KEY=

# --- Knowledge base search ----------------------------------------------------
# The search uses Amazon Titan embeddings through Bedrock, so AWS_REGION and AWS
# sign-in details above are needed even when SUPPORT_AGENT_PROVIDER=anthropic.
# Leave empty to use the default (amazon.titan-embed-text-v2:0).
SUPPORT_AGENT_EMBEDDING_MODEL=

# --- Logging --------------------------------------------------------------------
# Where the event log is written. Leave empty for logs/agent.jsonl.
SUPPORT_AGENT_LOG_FILE=

# --- Agent limits ------------------------------------------------------------
# Maximum number of model calls the agent may make for one customer message.
SUPPORT_AGENT_MAX_STEPS=8
# Maximum tokens (input + output) the agent may use for one customer message.
SUPPORT_AGENT_MAX_TOKENS_PER_MESSAGE=50000
# Maximum estimated cost of one whole conversation, in US dollars.
SUPPORT_AGENT_MAX_COST_USD=0.50
# Prices used for that estimate, in US dollars per million tokens. The defaults
# are for Claude Haiku 4.5. Check your provider's pricing page.
SUPPORT_AGENT_INPUT_PRICE_PER_MTOK=1.00
SUPPORT_AGENT_OUTPUT_PRICE_PER_MTOK=5.00
